<!DOCTYPE html>
<html lang="th">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>UBU Tracking Admin</title>


<style>

body{

font-family:Arial;
background:#f2f6f8;
padding:30px;

}


.box{

background:white;
padding:25px;
border-radius:15px;
max-width:800px;
margin:auto;
box-shadow:0 5px 20px #ccc;

}


h1{

text-align:center;
color:#087f73;

}


.card{

border:1px solid #ddd;
padding:15px;
margin-top:15px;
border-radius:10px;

}


select{

padding:10px;
border-radius:8px;

}


button{

padding:10px;
background:#10b981;
color:white;
border:none;
border-radius:8px;

}


</style>

</head>


<body>


<div class="box">


<h1>
UBU Tracking Admin
</h1>


<button onclick="loadProblems()">

โหลดข้อมูล

</button>


<div id="list">

</div>


</div>



<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


<script>


const SUPABASE_URL =
"https://zorgenrnjbwnzsnwalek.supabase.co";


const SUPABASE_KEY =
"ใส่ key เดียวกับ index.html";


const client =
supabase.createClient(
SUPABASE_URL,
SUPABASE_KEY
);




// โหลดข้อมูล

async function loadProblems(){


const {data,error}=await client

.from("problems")

.select("*")

.order(
"created_at",
{ascending:false}
);



if(error){

alert(error.message);
return;

}



let html="";



data.forEach(item=>{


html += `


<div class="card">


<h3>
${item.category}
</h3>


<p>
รหัสนักศึกษา:
${item.student_id}
</p>


<p>
รายละเอียด:
${item.detail}
</p>


<p>
สถานะปัจจุบัน:
${item.status}
</p>


<select 
onchange="updateStatus(${item.id},this.value)">


<option>
${item.status}
</option>

<option>
รอดำเนินการ
</option>

<option>
กำลังดำเนินการ
</option>

<option>
สำเร็จ
</option>


</select>


</div>


`;

});


document.getElementById("list")
.innerHTML=html;


}




// เปลี่ยนสถานะ


async function updateStatus(id,status){


const {error}=await client

.from("problems")

.update({

status:status

})

.eq(
"id",
id
);



if(error){

alert(error.message);

return;

}


alert("อัปเดตสถานะแล้ว");


loadProblems();


}



</script>


</body>

</html>
