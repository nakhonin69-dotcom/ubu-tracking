<!DOCTYPE html>
<html lang="th">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>UBU Tracking Status</title>

<style>

body{
font-family:Arial;
background:#f2f6f8;
display:flex;
justify-content:center;
align-items:center;
min-height:100vh;
}

.box{
background:white;
padding:30px;
width:400px;
border-radius:20px;
box-shadow:0 5px 20px #ccc;
}

h1{
text-align:center;
color:#087f73;
}

input,button{
width:100%;
padding:12px;
margin-top:10px;
box-sizing:border-box;
border-radius:8px;
}

button{
background:#10b981;
color:white;
border:none;
}

.card{
margin-top:15px;
padding:15px;
background:#f5f5f5;
border-radius:10px;
}

</style>

</head>


<body>


<div class="box">


<h1>
ติดตามสถานะปัญหา
</h1>


<input 
id="studentID"
placeholder="กรอกรหัสนักศึกษา">


<button onclick="checkStatus()">

ตรวจสอบสถานะ

</button>


<div id="result"></div>


</div>



<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


<script>


const SUPABASE_URL =
"https://zorgenrnjbwnzsnwalek.supabase.co";


const SUPABASE_KEY =
"sb_publishable_QHcqpDWzdd1ysgy_g0Eo1A_Epo-WVj9";



const db =
supabase.createClient(
SUPABASE_URL,
SUPABASE_KEY
);



async function checkStatus(){


let id =
document.getElementById("studentID")
.value.trim();



if(id===""){

alert("กรุณากรอกรหัสนักศึกษา");

return;

}



const {data,error}=await db

.from("problems")

.select("*")

.eq(
"student_id",
id
);



if(error){

alert(error.message);

return;

}



let html="";



if(data.length===0){

html=`

<div class="card">

ไม่พบข้อมูล

</div>

`;

}

else{


data.forEach(item=>{


html += `

<div class="card">


<p>
ปัญหา:
${item.detail}
</p>


<p>
ประเภท:
${item.category}
</p>


<p>
สถานะ:
<b>
${item.status}
</b>
</p>


</div>

`;


});


}



document.getElementById("result")
.innerHTML=html;


}



</script>


</body>

</html>
